# tempmail — example environment file. Placeholders only: never commit real values.
#
# The canonical configuration lives in ~/.config/tempmail/settings.json (chmod 600),
# created by `tempmail init`. These environment variables are OPTIONAL and, when set,
# take precedence over the file — useful for CI, containers and secret managers.

# Cloudflare API token. Minimum permissions:
#   Account > Workers Scripts     : Edit
#   Account > D1                  : Edit
#   Zone    > Zone                : Read
#   Zone    > Zone Settings       : Edit   <- required for Email Routing settings
#   Zone    > Email Routing Rules : Edit
#   Zone    > DNS                 : Read
CLOUDFLARE_API_TOKEN="cf_token_placeholder"

# Optional: skip account auto-discovery by pinning the account id.
CLOUDFLARE_ACCOUNT_ID="0000000000000000000000000000000"

# Slack Incoming Webhook that receives the notifications.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"

# Optional: override the settings file location.
# TEMPMAIL_CONFIG="/path/to/settings.json"
